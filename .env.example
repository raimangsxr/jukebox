# amrn-jukebox local development secrets (copy to .env)

JUKEBOX_DATABASE_PASSWORD=jukebox-dev-password
# Admin panel login (/login) — separate from the Postgres role above
JUKEBOX_OPERATOR_USERNAME=op
JUKEBOX_OPERATOR_PASSWORD=change-me-please-1234
JUKEBOX_SESSION_SECRET=dev-only-change-me-with-openssl-rand-hex-32
JUKEBOX_CORS_ALLOW_ORIGINS=http://localhost:8080,http://localhost:4200
# Optional: add LAN URLs if calling the API directly (e.g. http://192.168.1.10:8000).
# With Docker dev, the frontend proxies /api — use http://<host-ip>:4200 and CORS is not needed for login.
JUKEBOX_COOKIE_SECURE=false
JUKEBOX_FRAME_ANCESTORS='none'
# Comma-separated YouTube Data API v3 keys (backend); empty disables search on /participar
JUKEBOX_YOUTUBE_API_KEYS=
# Dev-only: participant login without Google on /participar
JUKEBOX_ALLOW_DEV_PARTICIPANT_AUTH=true
# Participant limits (rolling 10-minute windows for search/vote)
JUKEBOX_MAX_PENDING_SUBMISSIONS_PER_PARTICIPANT=2
JUKEBOX_MAX_SEARCHS_10MINUTES_PER_PARTICIPANT=10
JUKEBOX_MAX_VOTES_10MINUTES_PER_PARTICIPANT=2
